{
  "name": "agent-hollow",
  "version": "0.11.0",
  "description": "Agent Hollow: visualize Claude Code sessions as a pixel-art RTS",
  "type": "module",
  "license": "MIT",
  "author": "AJ Caylor <ajcaylor@gmail.com>",
  "contributors": [
    "Mateusz Pawelczuk (original author of Age of Agents)"
  ],
  "homepage": "https://acaylor.github.io/agent-hollow/",
  "repository": {
    "type": "git",
    "url": "https://github.com/acaylor/agent-hollow.git"
  },
  "bugs": {
    "url": "https://github.com/acaylor/agent-hollow/issues"
  },
  "bin": {
    "agent-hollow": "dist/cli.js",
    "hollow": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "claude-code",
    "rts",
    "visualization",
    "pixel-art",
    "cli"
  ],
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm --filter @agent-hollow/server dev\" \"pnpm --filter @agent-hollow/client dev\"",
    "demo": "concurrently -n server,client -c blue,green \"pnpm --filter @agent-hollow/server dev --demo\" \"pnpm --filter @agent-hollow/client dev\"",
    "assets": "node scripts/download-assets.mjs",
    "test": "pnpm --filter @agent-hollow/server test && pnpm --filter @agent-hollow/client test",
    "build:web": "pnpm --filter @agent-hollow/client build",
    "build:server": "node scripts/build-server.mjs",
    "build": "pnpm run build:web && pnpm run build:server",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": "^24.21.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "chokidar": "^5.0.0",
    "fastify": "^5.12.5",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "better-sqlite3": "^13.0.3"
  }
}
